# Copiá este archivo como .env.local y completá los valores.
# En producción, las mismas variables viven en Vercel → Settings → Environment Variables.
#
# Ojo: en Vercel están marcadas como Secret, así que el valor no se puede
# volver a leer una vez guardado. Si necesitás saber cuál es, se deduce desde
# MailerLite (ver docs/diagnostico-mailerlite.md), no desde el panel.

# ─────────────────────────────────────────────────────────────
# Supabase — donde se guardan todos los registros
# Project Settings → API
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─────────────────────────────────────────────────────────────
# MailerLite — cuenta principal
# Integrations → API
# ─────────────────────────────────────────────────────────────
MAILERLITE_API_KEY=eyJ...

# Grupo de la masterclass Y de la lista de espera (las dos comparten grupo).
# Lo usa /api/register.
MAILERLITE_GROUP_ID=123456789

# Grupo de la radiografía de ADN. Lo usa /api/diagnostico.
#
# TIENE QUE SER DISTINTO DE MAILERLITE_GROUP_ID. Es lo que dispara el envío
# del vídeo según el patrón, y el endpoint ya NO cae en el grupo de la
# masterclass si esta falta: corta y lo deja en los logs. Si está vacía,
# nadie recibe su vídeo (el registro sí se guarda en Supabase).
MAILERLITE_GROUP_ID_DIAGNOSTICO=987654321

# ─────────────────────────────────────────────────────────────
# MailerLite — cuenta de Academia (es una cuenta aparte)
# Lo usa /api/stripe-webhook tras un pago confirmado.
# ─────────────────────────────────────────────────────────────
MAILERLITE_ACADEMIA_API_KEY=eyJ...
MAILERLITE_ACADEMIA_GROUP_ID=123456789

# ─────────────────────────────────────────────────────────────
# Stripe — checkout de Academia ADN
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
# Developers → Webhooks → el endpoint → Signing secret
STRIPE_ACADEMIA_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────
# Opcional
# ─────────────────────────────────────────────────────────────
# Microsoft Clarity. Si se omite, se usa el proyecto por defecto que está
# escrito en components/Clarity.tsx. Solo se activa en producción.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
