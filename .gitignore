# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Artefactos de QA con navegador (perfiles de Chrome y capturas).
# Van ignorados además de por ruido: Tailwind escanea el árbol del proyecto en
# busca de clases, y dentro de estos perfiles hay CSS de extensiones que le
# hace generar utilidades con rutas que no existen. Eso rompe el build.
.atl/
